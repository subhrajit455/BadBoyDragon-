{
  "name": "shibham-enterprises-billing",
  "version": "1.0.0",
  "description": "Desktop Application for Sibham Enterprises Construction Billing & Inventory",
  "main": "electron/main.cjs",
  "author": "Sibham Enterprises",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:icons": "powershell -ExecutionPolicy Bypass -File scripts/create-icon.ps1",
    "build:client": "npm --prefix client run build",
    "dist": "npm run build:client && electron-builder --win"
  },
  "build": {
    "appId": "com.shibhamenterprises.billing",
    "productName": "Sibham Enterprises Billing",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sibham Enterprises Billing"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
